# Normalize to LF in the repository. Without this, editing on Windows and
# checking out on macOS/Linux rewrites every line, producing diffs where
# thousands of lines change but no content does.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary content.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
