DATABASE_URL=sqlite:///./promptguard.db
REDIS_URL=redis://localhost:6379/0
DEMO_TARGET_URL=http://localhost:8001/v1/chat/completions
JUDGE_PROVIDER=none
# Optional comma-separated AI jury, for example: openai,anthropic,google
OPENAI_JUDGE_MODEL=gpt-4o-mini
ANTHROPIC_JUDGE_MODEL=claude-3-5-haiku-latest
GOOGLE_JUDGE_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
# Encrypts target API keys at rest. LEAVE THIS BLANK AND CREDENTIALS ARE STORED
# IN PLAINTEXT. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EAGLEI_ENCRYPTION_KEY=
EAGLEI_CORS_ORIGINS=http://localhost:5173
EAGLEI_PROXY_API_KEY=
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
# --- Hugging Face target ---
HF_TOKEN=
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

MOCK_LLM=1
CANARY_SECRET=GENESIS-7731-INTERNAL

# --- Air-gapped micro-model sandbox ---
# Point this at a local quantized GGUF (e.g. TinyLlama-1.1B-Chat Q4_K_M) and
# install llama-cpp-python to serve internal:// targets on a real local model.
# Left blank, the sandbox uses its deterministic offline oracle.
MICRO_MODEL_PATH=
MICRO_MODEL_CTX=2048
MICRO_MODEL_GPU_LAYERS=0

# --- Response DLP thresholds ---
DLP_REDACT_THRESHOLD=30
DLP_BLOCK_THRESHOLD=70
ENTROPY_THRESHOLD=4.0
ENTROPY_MIN_LEN=20

# --- Plane 4: cryptographic audit ---
# Sealed segment keys are published here, atomically, for offline verification.
AUDIT_KEY_DIR=./data/audit_keys
